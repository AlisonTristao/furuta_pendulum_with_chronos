# Tick de 1 ms para a malha interna de 1 kHz
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# A UART0 é do protocolo: logs desligados. O console fica na UART0 (CONFIG_ESP_CONSOLE_NONE=y
# deixava o app reiniciando em loop no ESP-IDF 6.0.1); com logs NONE nada sai nele, só um pânico.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# ISR do gerador de passos em IRAM
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y

# -O2 no firmware (o MPC tem -O3 próprio, components/mpc)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Núcleo 1 dedicado ao MPC (embarcado.c): o IDLE dele pode ficar sem rodar
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
