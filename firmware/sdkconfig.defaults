# Tick de 1 ms para a malha interna de 1 kHz
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# A USB nativa é do BTP (TinyUSB CDC). Logs e console na UART0, que não está ligada a nada: logs desligados
# (um ESP_LOG bloquearia a tarefa que o chama). Erros da BTPDevice: `btp -errors` no terminal do TraceView.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BTPDEV_LOG_LEVEL_NONE=y

# Só o link Serial: sem Wi-Fi, BLE e ESP-NOW
# CONFIG_BTPDEV_LINK_TCP is not set
# CONFIG_BTPDEV_LINK_ESPNOW is not set


# app_main chama o device.begin() da BTPDevice (o padrão de 3584 B é pouco)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Cache e flash do S3 (N16R8: flash quad): o padrão (I-cache 16 KB, DIO) deixava o MPC 4x mais lento que no ESP32.
# O controlador em si roda da RAM (components/mpc/linker.lf); isto vale para o resto (libm, BTP).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ISR do gerador de passos em IRAM
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y

# -O2 no firmware (o MPC tem -O3 próprio, components/mpc)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Núcleo 1 dedicado ao MPC (embarcado.c): o IDLE dele pode ficar sem rodar
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
